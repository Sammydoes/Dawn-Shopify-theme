<div class="drawer" id="cart-drawer" aria-hidden="true">
 <div class="drawer__scrim" data-cart-close></div>
 <aside class="drawer__panel" role="dialog" aria-label="Cart">
  <header class="drawer__head"><strong>Your cart (<span data-cart-count>{{ cart.item_count }}</span>)</strong><button class="iconbtn" data-cart-close aria-label="Close">✕</button></header>
  <div class="drawer__ship">Free shipping on every order</div>
  <div class="drawer__body" data-cart-lines></div>
  <footer class="drawer__foot">
   <div class="drawer__sub"><span>Subtotal</span><strong data-cart-subtotal></strong></div>
   <a href="{{ routes.cart_url }}" class="btn btn--o btn--block">View cart</a>
   <form action="{{ routes.cart_url }}" method="post"><button type="submit" name="checkout" class="btn btn--p btn--block">Checkout</button></form>
   <span class="muted center small">{{ settings.cart_note }}</span>
  </footer>
 </aside>
</div>