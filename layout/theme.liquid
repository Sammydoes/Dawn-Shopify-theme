<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>{{ page_title }}{% unless page_title contains shop.name %} – {{ shop.name }}{% endunless %}</title>
{% if page_description %}<meta name="description" content="{{ page_description | escape }}">{% endif %}
<link rel="canonical" href="{{ canonical_url }}">
{% if settings.favicon %}<link rel="icon" href="{{ settings.favicon | image_url: width: 64 }}">{% endif %}
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400;12..96,500;12..96,600;12..96,700;12..96,800&family=Instrument+Serif:ital@0;1&display=swap" rel="stylesheet">
<style>:root{--ink:{{ settings.color_ink | default: '#1F2233' }};--cream:{{ settings.color_cream | default: '#FBF7F0' }};--pink:{{ settings.color_pink | default: '#D6336C' }};--yellow:{{ settings.color_yellow | default: '#F7CD4A' }};--teal:{{ settings.color_teal | default: '#2FAFB8' }}}</style>
{{ 'theme.css' | asset_url | stylesheet_tag }}
{{ content_for_header }}
</head>
<body>
<a class="skip" href="#main">Skip to content</a>
{% section 'header' %}
<main id="main">{{ content_for_layout }}</main>
{% section 'footer' %}
{% render 'cart-drawer' %}
<script>window.NL={cartUrl:{{ routes.cart_url | json }},upsell:{% if settings.upsell_product != blank %}{ id:{{ settings.upsell_product.selected_or_first_available_variant.id }},title:{{ settings.upsell_product.title | json }},price:{{ settings.upsell_product.price }},image:{{ settings.upsell_product.featured_image | image_url: width: 200 | json }},available:{{ settings.upsell_product.available }} }{% else %}null{% endif %}};</script>
<script src="{{ 'theme.js' | asset_url }}" defer></script>
</body>
</html>