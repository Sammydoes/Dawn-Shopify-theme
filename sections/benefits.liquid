<section class="wrap" style="padding-bottom:clamp(56px,7vw,112px)"><div class="grid3">{% for b in section.blocks %}<div class="ben" {{ b.shopify_attributes }}><div class="ben__img">{% render 'img', image: b.settings.image, alt: b.settings.heading, cls: 'cover', sizes: '(min-width:900px) 33vw, 100vw' %}</div><div class="ben__txt"><span class="badge tag--{{ b.settings.color }}">{{ b.settings.tag }}</span><h3>{{ b.settings.heading }}</h3><p>{{ b.settings.text }}</p></div></div>{% endfor %}</div></section>
{% schema %}
{
  "name": "Benefit cards",
  "blocks": [
    {
      "type": "card",
      "name": "Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "tag",
          "label": "Tag"
        },
        {
          "type": "select",
          "id": "color",
          "label": "Tag color",
          "options": [
            {
              "value": "pink",
              "label": "pink"
            },
            {
              "value": "yellow",
              "label": "yellow"
            },
            {
              "value": "teal",
              "label": "teal"
            }
          ],
          "default": "yellow"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Benefit cards",
      "blocks": [
        {
          "type": "card"
        },
        {
          "type": "card"
        }
      ]
    }
  ]
}
{% endschema %}
