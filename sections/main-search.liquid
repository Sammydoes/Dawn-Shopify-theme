<section class="wrap sec"><h1 style="font-size:clamp(40px,5vw,72px);margin-bottom:24px">Search</h1>
<form action="{{ routes.search_url }}" method="get" class="row" style="margin-bottom:40px"><input type="search" name="q" value="{{ search.terms | escape }}" placeholder="Search" style="flex:1 1 280px;height:56px;border-radius:999px;border:1.5px solid #D9CFC0;padding:0 22px;font:inherit;background:#fff"><button class="btn btn--ink" type="submit">Search</button></form>
{%- if search.performed -%}{%- paginate search.results by 24 -%}<p class="muted" style="margin-bottom:24px">{{ search.results_count }} results for “{{ search.terms }}”</p>
<div class="pgrid">{%- for item in search.results -%}{%- if item.object_type == 'product' -%}{% render 'product-card', card_product: item %}{%- else -%}<a class="edi" style="background:var(--sand);color:var(--ink);aspect-ratio:auto;min-height:140px;justify-content:center" href="{{ item.url }}"><strong style="font-size:22px">{{ item.title }}</strong></a>{%- endif -%}{%- endfor -%}</div>
{%- if paginate.pages > 1 -%}<div class="pager">{% if paginate.previous %}<a class="pill" href="{{ paginate.previous.url }}">Previous</a>{% endif %}{% if paginate.next %}<a class="pill" href="{{ paginate.next.url }}">Next</a>{% endif %}</div>{%- endif -%}{%- endpaginate -%}{%- endif -%}</section>
{% schema %}
{
  "name": "Search"
}
{% endschema %}
