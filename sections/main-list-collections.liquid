<section class="wrap sec"><h1 style="font-size:clamp(40px,5vw,72px);margin-bottom:32px">Collections</h1><div class="pgrid">{% for c in collections %}<a class="post" href="{{ c.url }}"><div class="post__i">{% if c.image %}{{ c.image | image_url: width: 900 | image_tag: class: 'cover', alt: c.title, loading: 'lazy' }}{% else %}<div class="ph cover">{{ c.title }}</div>{% endif %}</div><h3>{{ c.title }}</h3></a>{% endfor %}</div></section>
{% schema %}
{
  "name": "Collections list"
}
{% endschema %}
