<section class="wrap" style="padding-bottom:clamp(56px,7vw,112px)"><h2 class="center" style="margin-bottom:28px">{{ section.settings.heading }}</h2><div class="faq">{% for b in section.blocks %}<details {% if forloop.first %}open{% endif %} {{ b.shopify_attributes }}><summary>{{ b.settings.q }}</summary><div class="ans">{{ b.settings.a }}</div></details>{% endfor %}</div></section>
{% schema %}
{
  "name": "FAQ",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Good questions."
    }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "Question",
      "settings": [
        {
          "type": "text",
          "id": "q",
          "label": "Question"
        },
        {
          "type": "richtext",
          "id": "a",
          "label": "Answer"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ",
      "blocks": [
        {
          "type": "faq"
        },
        {
          "type": "faq"
        },
        {
          "type": "faq"
        }
      ]
    }
  ]
}
{% endschema %}
