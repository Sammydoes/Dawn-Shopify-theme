{%- if section.settings.ann1 != blank -%}<div class="ann"><span>{% if section.settings.ann_link %}<a href="{{ section.settings.ann_link }}">{{ section.settings.ann1 }}</a>{% else %}{{ section.settings.ann1 }}{% endif %}</span>{% if section.settings.ann2 != blank %}<span>{{ section.settings.ann2 }}</span>{% endif %}</div>{%- endif -%}
<header class="hdr"><div class="wrap hdr__in">
 <nav class="nav" aria-label="Main">
  {%- assign main_links = linklists[section.settings.menu].links -%}{%- if main_links.size == 0 -%}<div class="dd"><a href="/collections/all">Shop</a><button class="dd__arrow" type="button" aria-label="Show options" data-dd-toggle><svg width="12" height="12" viewBox="0 0 12 12"><path d="M2 4.5l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></button><div class="dd__menu"><a href="/collections/all">Shop all</a><a href="/collections/all#bundles">Bundles</a></div></div><a href="/pages/our-story">Our Story</a><a href="/pages/help">Help</a>{%- endif -%}{%- for l in main_links -%}{%- if l.links.size > 0 -%}<div class="dd"><a href="{{ l.url }}"{% if l.active %} aria-current="page"{% endif %}>{{ l.title }}</a><button class="dd__arrow" type="button" aria-label="Show options" data-dd-toggle><svg width="12" height="12" viewBox="0 0 12 12"><path d="M2 4.5l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></button><div class="dd__menu">{% for c in l.links %}<a href="{{ c.url }}">{{ c.title }}</a>{% endfor %}</div></div>{%- else -%}<a href="{{ l.url }}"{% if l.active %} aria-current="page"{% endif %}>{{ l.title }}</a>{%- endif -%}{%- endfor -%}
  <button class="iconbtn menubtn" data-menu-toggle aria-label="Menu">☰</button>
 </nav>
 <a class="hdr__logo" href="{{ routes.root_url }}" aria-label="{{ shop.name }}">{% if section.settings.logo %}{{ section.settings.logo | image_url: width: 400 | image_tag: alt: shop.name, loading: 'eager' }}{% else %}<img src="{{ 'noodlelox-wordmark.png' | asset_url }}" alt="{{ shop.name }}">{% endif %}</a>
 <div class="hdr__r">
  <a class="pill hdr__links" style="border-color:transparent;background:none" href="{{ routes.search_url }}">Search</a>
  <a class="pill hdr__links" style="border-color:transparent;background:none" href="{{ routes.account_url }}">Account</a>
  <a class="cartbtn" href="{{ routes.cart_url }}" data-cart-open>Cart <b data-cart-count>{{ cart.item_count }}</b></a>
 </div>
</div>
<nav class="mnav" id="mnav"><div class="dd" style="border-bottom:1px solid #EFE7DA"><a href="{{ routes.root_url }}" style="flex:none;padding:12px 4px;font-size:18px;border:0">Home</a></div>{%- for l in linklists[section.settings.menu].links -%}<div class="dd" style="flex-wrap:wrap;border-bottom:1px solid #EFE7DA"><a href="{{ l.url }}" style="flex:1;border:0">{{ l.title }}</a>{%- if l.links.size > 0 -%}<button class="dd__arrow" type="button" aria-label="Show options" data-dd-toggle style="width:44px;height:44px"><svg width="14" height="14" viewBox="0 0 12 12"><path d="M2 4.5l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></button><div class="mnav__sub" style="width:100%">{%- for c in l.links -%}<a href="{{ c.url }}" style="display:block;padding:12px 8px 12px 24px;font-size:17px;font-weight:500;color:#5B5F6D">{{ c.title }}</a>{%- endfor -%}</div>{%- endif -%}</div>{%- endfor -%}</nav>
</header>
{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "text",
      "id": "ann1",
      "label": "Announcement",
      "default": "Buy one set, get a second for $99 — auto-applied at checkout"
    },
    {
      "type": "text",
      "id": "ann2",
      "label": "Announcement (right)",
      "default": "Free shipping · 30-day returns · 1-year warranty"
    },
    {
      "type": "url",
      "id": "ann_link",
      "label": "Announcement link"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu",
      "default": "main-menu"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo"
    }
  ]
}
{% endschema %}
