<section class="wrap sec--tight" style="padding-top:clamp(20px,3vw,40px)"><div class="chero"><div class="chero__t"><div class="crumbs"><a href="{{ routes.root_url }}">Home</a><span>/</span><span style="color:var(--ink)">{{ collection.title }}</span></div><h1 style="font-size:clamp(48px,6.4vw,96px)">{{ collection.title }}</h1>{% if collection.description != blank %}<div class="lead">{{ collection.description }}</div>{% endif %}</div>
<div class="chero__i">{% if collection.image %}{{ collection.image | image_url: width: 1600 | image_tag: class: 'cover', alt: collection.title, loading: 'eager' }}{% else %}{% render 'img', image: section.settings.image, fallback: '/cdn/shop/files/DSC_9093.jpg?width=1600', alt: '', cls: 'cover' %}{% endif %}</div></div></section>
{%- paginate collection.products by section.settings.per_page -%}
<div class="filters"><div class="wrap filters__in">
 <div class="row" style="gap:8px">
  {%- for f in collection.filters -%}{%- if f.type == 'list' -%}{%- for v in f.values -%}<a class="pill{% if v.active %} on{% endif %}" href="{% if v.active %}{{ v.url_to_remove }}{% else %}{{ v.url_to_add }}{% endif %}">{{ v.label }} <span style="font-size:13px;opacity:.7">{{ v.count }}</span></a>{%- endfor -%}{%- endif -%}{%- endfor -%}
  {%- if collection.filters.size == 0 -%}<a class="pill on" href="{{ collection.url }}">All</a>{%- endif -%}
 </div>
 <div class="row muted"><span>{{ collection.products_count }} products</span>
  <select class="sel" aria-label="Sort" onchange="location.href=this.value">{% assign sb = collection.sort_by | default: collection.default_sort_by %}{% for o in collection.sort_options %}<option value="{{ collection.url }}?sort_by={{ o.value }}"{% if o.value == sb %} selected{% endif %}>{{ o.name }}</option>{% endfor %}</select></div>
</div></div>
<section class="wrap" style="padding-top:8px;padding-bottom:clamp(56px,7vw,112px)">
 <div class="pgrid">
  {%- for p in collection.products -%}{% render 'product-card', card_product: p %}{%- else -%}<p class="muted">No products match these filters.</p>{%- endfor -%}
  {%- if section.settings.tile_url != blank and paginate.current_page == 1 -%}<a class="edi" href="{{ section.settings.tile_url }}">{% render 'img', image: section.settings.tile_image, fallback: '/cdn/shop/files/DSC_9103.jpg?width=900', alt: '', cls: 'cover' %}<span class="eyebrow">{{ section.settings.tile_eyebrow }}</span><strong>{{ section.settings.tile_title }}</strong></a>{%- endif -%}
 </div>
 {%- if paginate.pages > 1 -%}<div class="pager">{% if paginate.previous %}<a class="pill" href="{{ paginate.previous.url }}">Previous</a>{% endif %}{% for part in paginate.parts %}{% if part.is_link %}<a class="pill" href="{{ part.url }}">{{ part.title }}</a>{% else %}<span class="pill on">{{ part.title }}</span>{% endif %}{% endfor %}{% if paginate.next %}<a class="pill" href="{{ paginate.next.url }}">Next</a>{% endif %}</div>{%- endif -%}
</section>
{%- endpaginate -%}
{% schema %}
{
  "name": "Collection",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Hero image (if collection has none)"
    },
    {
      "type": "range",
      "id": "per_page",
      "label": "Products per page",
      "min": 8,
      "max": 48,
      "step": 4,
      "default": 24
    },
    {
      "type": "text",
      "id": "tile_eyebrow",
      "label": "Editorial tile eyebrow",
      "default": "Gift guide"
    },
    {
      "type": "text",
      "id": "tile_title",
      "label": "Editorial tile title",
      "default": "The birthday gift they’ll still play with next year."
    },
    {
      "type": "url",
      "id": "tile_url",
      "label": "Editorial tile link"
    },
    {
      "type": "image_picker",
      "id": "tile_image",
      "label": "Editorial tile image"
    }
  ]
}
{% endschema %}
