<section class="wrap" style="padding-top:clamp(40px,6vw,96px);padding-bottom:32px"><div class="head" style="margin:0"><div style="display:flex;flex-direction:column;gap:14px"><span class="eyebrow">{{ section.settings.eyebrow }}</span><h1 style="font-size:clamp(48px,7vw,104px)">{{ section.settings.heading }}</h1></div><p class="lead" style="max-width:380px">{{ section.settings.text }}</p></div></section>
{%- paginate blog.articles by 12 -%}
{%- assign show_feat = false -%}{%- if paginate.current_page == 1 and current_tags == blank and blog.articles.size > 0 -%}{%- assign show_feat = true -%}{%- endif -%}
{%- if show_feat -%}{%- assign a = blog.articles.first -%}
<section class="wrap"><a class="bfeat" href="{{ a.url }}"><div class="bfeat__i">{% if a.image %}{{ a.image | image_url: width: 1600 | image_tag: class: 'cover', alt: a.title, loading: 'eager' }}{% else %}<div class="ph cover"></div>{% endif %}</div><div class="bfeat__t"><div class="row small">{% if a.tags.first %}<span class="badge tag--yellow">{{ a.tags.first }}</span>{% endif %}<span class="muted">{{ a.published_at | date: '%b %-d, %Y' }}</span></div><h2 style="font-size:clamp(32px,3.6vw,52px)">{{ a.title }}</h2><p class="lead">{{ a.excerpt_or_content | strip_html | truncatewords: 28 }}</p><strong style="text-decoration:underline;text-underline-offset:4px">Read the guide</strong></div></a></section>{%- endif -%}
{%- if blog.all_tags.size > 0 -%}<section class="wrap row" style="padding-top:40px;padding-bottom:8px;gap:8px"><a class="pill{% unless current_tags %} on{% endunless %}" href="{{ blog.url }}">All</a>{% for tg in blog.all_tags %}<a class="pill{% if current_tags contains tg %} on{% endif %}" href="{{ blog.url }}/tagged/{{ tg | handleize }}">{{ tg }}</a>{% endfor %}</section>{%- endif -%}
<section class="wrap" style="padding-top:24px;padding-bottom:clamp(56px,7vw,112px)"><div class="posts">
{%- for a in blog.articles -%}{%- if show_feat and forloop.first -%}{%- continue -%}{%- endif -%}
<a class="post" href="{{ a.url }}"><div class="post__i">{% if a.image %}{{ a.image | image_url: width: 900 | image_tag: class: 'cover', alt: a.title, loading: 'lazy' }}{% else %}<div class="ph cover"></div>{% endif %}</div><div class="post__m">{% if a.tags.first %}<span class="badge tag--yellow">{{ a.tags.first }}</span>{% endif %}<span class="muted">{{ a.published_at | date: '%b %-d, %Y' }}</span></div><h3>{{ a.title }}</h3><p>{{ a.excerpt_or_content | strip_html | truncatewords: 22 }}</p></a>{%- endfor -%}
</div>{%- if paginate.pages > 1 -%}<div class="pager">{% if paginate.previous %}<a class="pill" href="{{ paginate.previous.url }}">Previous</a>{% endif %}{% if paginate.next %}<a class="pill" href="{{ paginate.next.url }}">Next</a>{% endif %}</div>{%- endif -%}</section>
{%- endpaginate -%}
{% schema %}
{
  "name": "Blog",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "The Build Journal"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Ideas for <em>big</em> play."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Build guides, screen-free game plans and the science of how kids learn through play."
    }
  ]
}
{% endschema %}
