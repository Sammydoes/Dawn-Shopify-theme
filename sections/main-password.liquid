<section class="wrap shero" style="min-height:100vh;justify-content:center"><h1>{{ shop.name }}</h1><p class="lead">This store is opening soon.</p>
{% form 'storefront_password' %}{{ form.errors | default_errors }}<div class="row" style="justify-content:center"><input type="password" name="password" placeholder="Password" style="height:56px;border-radius:999px;border:1.5px solid #D9CFC0;padding:0 22px;font:inherit"><button class="btn btn--p" type="submit">Enter</button></div>{% endform %}</section>
{% schema %}
{
  "name": "Password"
}
{% endschema %}
