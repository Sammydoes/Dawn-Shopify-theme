<section class="wrap shero"><span class="eyebrow">Help center</span><h1>How can we <em>help?</em></h1><p class="lead">{{ section.settings.sub }}</p></section>
<section class="wrap" style="padding-bottom:clamp(56px,7vw,104px)"><div class="vals">{% for b in section.blocks %}{% if b.type == 'card' %}<a class="val" style="background:{{ b.settings.bg }};min-height:220px;color:var(--ink)" href="{{ b.settings.link }}" {{ b.shopify_attributes }}><span style="font-size:15px;color:var(--pink)">0{{ forloop.index }}</span><h3>{{ b.settings.title }}</h3><p>{{ b.settings.text }}</p></a>{% endif %}{% endfor %}</div></section>
<section class="band" id="faq"><div class="wrap sec split" style="align-items:start"><div><span class="eyebrow">FAQ</span><h2 style="margin-top:14px">Good <em>questions.</em></h2></div><div class="faq" style="margin:0;max-width:none">{% for b in section.blocks %}{% if b.type == 'faq' %}<details {{ b.shopify_attributes }}><summary>{{ b.settings.q }}</summary><div class="ans">{{ b.settings.a }}</div></details>{% endif %}{% endfor %}</div></div></section>
<section class="wrap sec" id="contact"><div class="offer" style="background:var(--ink)"><div class="offer__t"><span class="eyebrow" style="color:var(--yellow)">Contact us</span><h2 style="font-size:clamp(36px,4.4vw,62px)">Still need <em>a hand?</em></h2><p>{{ section.settings.contact_text }}</p></div>
<div style="padding:clamp(28px,4vw,56px);background:#2A2E40">{% form 'contact', class: 'help-form' %}{% if form.posted_successfully? %}<strong style="font-size:24px">Thanks, message sent ✓</strong>{% else %}<div style="display:flex;flex-direction:column;gap:14px"><input name="contact[name]" placeholder="Your name" required><input type="email" name="contact[email]" placeholder="Email" required><input name="contact[Order number]" placeholder="Order number (optional)"><textarea name="contact[body]" rows="5" placeholder="How can we help?" required></textarea><button class="btn btn--p" type="submit" style="height:58px">Send message</button></div>{% endif %}{% endform %}</div></div></section>
{% schema %}
{"name":"Help page","settings":[{"type":"text","id":"sub","label":"Subtitle","default":"Our team is available 24/7. Find a quick answer below, or send us a message."},{"type":"textarea","id":"contact_text","label":"Contact text","default":"Questions about an order, a missing piece or what to build first? Send us a note and a real person will get back to you."}],"blocks":[{"type":"card","name":"Quick card","settings":[{"type":"text","id":"title","label":"Title"},{"type":"text","id":"text","label":"Text"},{"type":"url","id":"link","label":"Link"},{"type":"color","id":"bg","label":"Background","default":"#FBE3EA"}]},{"type":"faq","name":"Question","settings":[{"type":"text","id":"q","label":"Question"},{"type":"richtext","id":"a","label":"Answer"}]}],"presets":[{"name":"Help page"}]}
{% endschema %}
