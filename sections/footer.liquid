<footer class="ftr"><div class="wrap">
 <div class="ftr__top">
  <div style="max-width:520px"><h3>{{ section.settings.heading }}</h3><p style="margin-top:18px">{{ section.settings.text }}</p>
   {% form 'customer', class: 'ftr__form' %}<input type="hidden" name="contact[tags]" value="newsletter"><input type="email" name="contact[email]" placeholder="Your email" required aria-label="Email"><button class="btn btn--y" type="submit" style="height:52px">{% if form.posted_successfully? %}You're in ✓{% else %}Sign up{% endif %}</button>{% endform %}</div>
  <div class="ftr__cols">
   {%- assign m1 = linklists[section.settings.menu1] -%}{%- assign m2 = linklists[section.settings.menu2] -%}{%- assign m3 = linklists[section.settings.menu3] -%}
   <div class="ftr__col"><span>{{ section.settings.t1 }}</span>{% for l in m1.links %}<a href="{{ l.url }}">{{ l.title }}</a>{% else %}<a href="/products/noodlelox50piecekit">50-Piece Play Set</a><a href="/products/all-you-need">All You Need</a><a href="/products/noodlelox-carry-bag">Carry Bag</a><a href="/collections/all">Shop all</a>{% endfor %}</div>
   <div class="ftr__col"><span>{{ section.settings.t2 }}</span>{% for l in m2.links %}<a href="{{ l.url }}">{{ l.title }}</a>{% else %}<a href="/pages/help">Help center</a><a href="/policies/shipping-policy">Shipping</a><a href="/policies/refund-policy">Returns</a><a href="/pages/help#faq">Warranty</a>{% endfor %}</div>
   <div class="ftr__col"><span>{{ section.settings.t3 }}</span>{% for l in m3.links %}<a href="{{ l.url }}">{{ l.title }}</a>{% else %}<a href="/pages/our-story">Our story</a><a href="https://noodlelox.goaffpro.com">Affiliates</a><a href="/pages/help#contact">Contact us</a>{% endfor %}</div>
  </div>
 </div>
 <div class="ftr__bot"><div class="row" style="gap:20px"><span>© {{ 'now' | date: '%Y' }} {{ shop.name }}</span><a href="{{ routes.privacy_policy_url }}">Privacy</a><a href="{{ routes.terms_of_service_url }}">Terms</a></div>
  <div class="ftr__soc">{% if settings.social_instagram != blank %}<a href="{{ settings.social_instagram }}">Instagram</a>{% endif %}{% if settings.social_youtube != blank %}<a href="{{ settings.social_youtube }}">YouTube</a>{% endif %}{% if settings.social_facebook != blank %}<a href="{{ settings.social_facebook }}">Facebook</a>{% endif %}</div></div>
</div><div class="ftr__bar"><i style="background:var(--pink)"></i><i style="background:var(--yellow)"></i><i style="background:var(--teal)"></i><i style="background:#3F6FD8"></i></div></footer>
{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Join the build club.<br><em>New creations every month.</em>"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Build ideas, early access to new sets and members-only offers. No spam, only good stuff."
    },
    {
      "type": "text",
      "id": "t1",
      "label": "Column 1 title",
      "default": "Shop"
    },
    {
      "type": "link_list",
      "id": "menu1",
      "label": "Column 1 menu",
      "default": "footer"
    },
    {
      "type": "text",
      "id": "t2",
      "label": "Column 2 title",
      "default": "Help"
    },
    {
      "type": "link_list",
      "id": "menu2",
      "label": "Column 2 menu"
    },
    {
      "type": "text",
      "id": "t3",
      "label": "Column 3 title",
      "default": "Company"
    },
    {
      "type": "link_list",
      "id": "menu3",
      "label": "Column 3 menu"
    }
  ]
}
{% endschema %}
