{%- assign set = section.settings.set_product -%}{%- assign bag = section.settings.bag_product -%}
<section class="wrap" style="padding-bottom:clamp(56px,7vw,112px)" id="build-your-own"><div class="byo" data-byo data-set-id="{{ set.selected_or_first_available_variant.id }}" data-bag-id="{{ bag.selected_or_first_available_variant.id }}" data-set-price="{{ set.price }}" data-extra-price="{{ section.settings.extra_set_price | times: 100 }}" data-bag-price="{{ bag.price }}">
 <div class="byo__l"><span class="eyebrow">{{ section.settings.eyebrow }}</span><h2 style="font-size:clamp(30px,3.4vw,46px)">{{ section.settings.heading }}</h2><p class="muted">{{ section.settings.text }}</p>
  {%- for p in (1..2) -%}{%- if p == 1 -%}{%- assign prod = set -%}{%- assign key = 'set' -%}{%- else -%}{%- assign prod = bag -%}{%- assign key = 'bag' -%}{%- endif -%}
  <div class="byo__row"><div class="byo__img">{% if prod.featured_image %}{{ prod.featured_image | image_url: width: 200 | image_tag: alt: '', loading: 'lazy' }}{% endif %}</div><div style="flex:1"><strong>{{ prod.title }}</strong><div class="muted small">{{ prod.price | money_without_trailing_zeros }}{% if key == 'set' %} first · {{ section.settings.extra_set_price | times: 100 | money_without_trailing_zeros }} each extra{% endif %}</div></div>
   <div class="qty" style="height:48px"><button type="button" data-byo-step="{{ key }}" data-d="-1" aria-label="Fewer">−</button><span data-byo-qty="{{ key }}" style="min-width:24px;text-align:center;font-weight:700">{% if key == 'set' %}1{% else %}0{% endif %}</span><button type="button" data-byo-step="{{ key }}" data-d="1" aria-label="More">+</button></div></div>
  {%- endfor -%}
 </div>
 <div class="byo__r"><span class="eyebrow" style="color:var(--yellow)">Your bundle</span><div style="display:flex;justify-content:space-between;align-items:baseline"><span>Total</span><strong data-byo-total style="font-size:42px;letter-spacing:-.02em"></strong></div><span class="badge badge--yellow" data-byo-save hidden></span><button class="btn btn--p btn--block" style="height:60px" type="button" data-byo-add>Add bundle to cart</button><span class="small" style="color:#9A9CA8">The extra-set price is applied at checkout by your Shopify discount (see README).</span></div>
</div></section>
{% schema %}
{"name":"Build your own bundle","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"Build your own"},{"type":"inline_richtext","id":"heading","label":"Heading","default":"Make it <em>yours.</em>"},{"type":"text","id":"text","label":"Text","default":"Every extra set is just $99."},{"type":"product","id":"set_product","label":"Play Set product"},{"type":"product","id":"bag_product","label":"Carry Bag product"},{"type":"number","id":"extra_set_price","label":"Price of each extra set (display)","default":99}],"presets":[{"name":"Build your own bundle"}]}
{% endschema %}
