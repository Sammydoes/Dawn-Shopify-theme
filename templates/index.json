    "faq": {
      "type": "faq",
      "settings": {},
      "blocks": {
        "faq_1": {
          "type": "faq",
          "settings": {
            "q": "How many creations can one set make?",
            "a": "<p>Hundreds. Each set includes a booklet of 28 designs of varying difficulty. After that, it’s up to their imagination.</p>"
          }
        },
        "faq_2": {
          "type": "faq",
          "settings": {
            "q": "Is it safe for little ones?",
            "a": "<p>Noodles are soft polyethylene foam and connectors are injection-molded polypropylene. Designed for ages 3+ with grown-up supervision for the youngest builders.</p>"
          }
        },
        "faq_3": {
          "type": "faq",
          "settings": {
            "q": "Does it need any assembly?",
            "a": "<p>No setup, no tools. Everything is ready out of the box.</p>"
          }
        },
        "faq_4": {
          "type": "faq",
          "settings": {
            "q": "Can I use my own pool noodles?",
            "a": "<p>Our noodles and connectors are made together for a precise friction fit. Other noodles may work, but Noodlelox noodles perform best.</p>"
          }
        },
        "faq_5": {
          "type": "faq",
          "settings": {
            "q": "What if we don’t love it?",
            "a": "<p>Contact us within 30 days of delivery for a full refund, with no restocking fee. Every set also carries a 1-year limited warranty.</p>"
          }
        }
      },
