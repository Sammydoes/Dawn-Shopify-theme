{%- layout none -%}<!doctype html><html lang="{{ request.locale.iso_code }}"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>{{ 'Gift card' }} — {{ shop.name }}</title>{{ 'theme.css' | asset_url | stylesheet_tag }}</head><body><div class="wrap shero"><h1>{{ gift_card.balance | money }}</h1><p class="lead">Gift card for {{ shop.name }}</p><p><strong>{{ gift_card.code | format_code }}</strong></p><a class="btn btn--p" href="{{ shop.url }}">Start shopping</a></div></body></html>